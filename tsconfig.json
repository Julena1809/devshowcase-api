{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "rootDir": "./src/",
    "baseUrl": "./",
    "outDir": "./dist/"
    
  },
  
  "include": [
    "**/*.ts"
    
  ]
}